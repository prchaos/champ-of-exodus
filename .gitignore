# KMS secrets: only the plaintext file is ignored — secrets/prod.env.enc
# (the encrypted, base64-encoded ciphertext) must be committed. Deliberately
# specific rather than a `secrets/*` glob for exactly that reason.
secrets/prod.env
.github/agents/*
token.txt
build_admin_service.md
